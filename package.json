{
  "name": "lumina-studio",
  "productName": "Lumina Studio",
  "version": "2.0.0",
  "description": "Suíte Lumina: editor de fotos, texto, planilhas e apresentações para desktop.",
  "main": "electron/main.js",
  "author": "mello13256",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "web": "npx http-server src -p 8080 -c-1",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "postinstall": "node scripts/vendor.js"
  },
  "devDependencies": {
    "chart.js": "^4.6.1",
    "docx": "^9.14.0",
    "dompurify": "^3.4.17",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "pptxgenjs": "^4.0.1"
  },
  "build": {
    "appId": "com.lumina.studio",
    "productName": "Lumina Studio",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "lumina",
        "name": "Imagem Lumina",
        "description": "Projeto do Lumina Foto",
        "role": "Editor"
      },
      {
        "ext": "lumdoc",
        "name": "Documento Lumina",
        "description": "Documento do Lumina Texto",
        "role": "Editor"
      },
      {
        "ext": "lumsheet",
        "name": "Planilha Lumina",
        "description": "Planilha do Lumina Planilhas",
        "role": "Editor"
      },
      {
        "ext": "lumslides",
        "name": "Apresentação Lumina",
        "description": "Apresentação do Lumina Apresentações",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumina Studio",
      "artifactName": "LuminaStudio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "LuminaStudio-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    }
  }
}
